# Required: create a long random value; this protects the web app
APP_ACCESS_TOKEN=replace-with-a-long-random-secret

# Telegram: create a bot with @BotFather, then set the token and your numeric Telegram user ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Azure OpenAI: endpoint, model deployment name and key from Azure AI Foundry / Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
APP_TIMEZONE=Asia/Qyzylorda

# Point this to persistent storage in Azure. For local development, the default is ./data/assistant.sqlite3
APP_DB_PATH=./data/assistant.sqlite3
PORT=8000
