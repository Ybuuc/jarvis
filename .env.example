# Required: create a long random value; this protects the web app
APP_ACCESS_TOKEN=replace-with-a-long-random-secret

# Telegram: create a bot with @BotFather, then set the token and your numeric Telegram user ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# AI option 1: any OpenAI-compatible provider (Gemini, Groq, OpenRouter, ...).
# If all three are set, they are used instead of Azure OpenAI below.
# Example for Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# The model must support function calling. Take the model name from the provider's own model list.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: some models accept only the default temperature; set to empty to omit it (default 0.4)
AI_TEMPERATURE=0.4

# AI option 2: Azure OpenAI: endpoint, model deployment name and key from Azure AI Foundry / Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
APP_TIMEZONE=Asia/Qyzylorda

# Point this to persistent storage in Azure. For local development, the default is ./data/assistant.sqlite3
APP_DB_PATH=./data/assistant.sqlite3
PORT=8000
